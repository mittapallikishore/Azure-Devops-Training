        </mxCell>

        <mxCell id="request" value="Example request: GET /api/customers/150250/orders&#xa;CustomerID 150250 falls in range 100,001 - 200,000&#xa;Router sends request to Shard 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="400" width="420" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="scaling" value="FUTURE SCALING - ADD SHARD 4&#xa;Split Shard 3 range, for example:&#xa;Shard 3: 200,001 - 250,000&#xa;Shard 4: 250,001 - 300,000&#xa;Migrate records, validate data, update shard map and redirect traffic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="560" width="440" height="150" as="geometry"/>
