        <mxCell id="shard2" value="DATABASE SHARD 2&#xa;CustomerID: 100,001 - 200,000&#xa;Customer and order records&#xa;Example: 150250" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
